NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
TRUST_PROXY=false

# MongoDB: IoT events, time-series style documents, change streams
MONGODB_URI=mongodb://127.0.0.1:27017/crystal_ball
MONGO_CHANGE_STREAMS_ENABLED=false # Set true locally only when MongoDB runs as a replica set

# PostgreSQL: tenant/user/RBAC/billing/audit relational truth
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crystal_ball?schema=public

# MySQL: external ERP/CMMS integration only
MYSQL_HOST=
MYSQL_READ_HOST=
MYSQL_PORT=3306
MYSQL_USER=erp_reader
MYSQL_PASSWORD=
MYSQL_DATABASE=erp
MYSQL_POOL_LIMIT=10
# Map these to the ERP/CMMS schema provided by its owner; leave unset until confirmed.
ERP_WORK_ORDERS_TABLE=
ERP_WORK_ORDER_ID_COLUMN=
ERP_ASSET_CODE_COLUMN=
ERP_STATUS_COLUMN=
ERP_DESCRIPTION_COLUMN=
ERP_SCHEDULED_AT_COLUMN=
ERP_COMPLETED_AT_COLUMN=
# Comma-separated procedures granted EXECUTE by the ERP DBA and verified read-only.
ERP_READONLY_PROCEDURES=

# Redis: refresh-token rotation, BullMQ, Socket.IO adapter and shared runtime
REDIS_URL=redis://127.0.0.1:6379

# Generate an RSA key pair; store PEM values securely and never commit them.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_SECONDS=2592000

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
LLM_TIMEOUT_MS=8000
# Configure rates for the selected Anthropic model; USD per 1 million tokens.
LLM_INPUT_USD_PER_MILLION=3
LLM_OUTPUT_USD_PER_MILLION=15
# 0 disables the daily spend threshold. Alerts require ONCALL_WEBHOOK_URL and Redis.
LLM_DAILY_BUDGET_USD=25
LLM_CACHE_TTL_SECONDS=600
# Circuit breaker: open after N consecutive LLM outage errors, probe again after the cooldown.
LLM_CIRCUIT_FAILURE_THRESHOLD=5
LLM_CIRCUIT_COOLDOWN_MS=30000
AI_QUEUE_NAME=ai-decisions
# HTTPS webhook for your PagerDuty/Opsgenie/custom on-call integration.
ONCALL_WEBHOOK_URL=
ONCALL_WEBHOOK_TOKEN=
ONCALL_TIMEOUT_MS=5000
ROUTING_WORKER_CONCURRENCY=5
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000

AWS_REGION=ap-south-1
S3_BUCKET=
# ClamAV daemon endpoint. Uploads remain quarantined until this scanner returns clean.
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000
S3_ENDPOINT= # Optional MinIO endpoint, e.g. http://127.0.0.1:9000

# Optional embeddings provider used by pgvector RAG retrieval
EMBEDDINGS_API_KEY=
EMBEDDINGS_API_URL=https://api.openai.com/v1/embeddings
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_INPUT_USD_PER_MILLION=0.02

# One-time development/demo seed values (use unique, strong values; never deploy defaults)
SEED_TENANT_NAME=Crystal Ball Demo
SEED_TENANT_SLUG=crystal-ball-demo
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_NAME=Demo Admin
SEED_ADMIN_PASSWORD=

# Optional bearer token for the Prometheus metrics endpoint
METRICS_TOKEN=
