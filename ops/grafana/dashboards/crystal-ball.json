{
  "id": null,
  "uid": "crystal-ball-ops",
  "title": "Crystal Ball - Operations & LLM Cost",
  "tags": [
    "crystal-ball",
    "operations",
    "llm"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "LLM requests / second",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(crystal_ball_llm_requests_total[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Estimated LLM spend (USD)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (model) (increase(crystal_ball_llm_cost_usd_total[1d]))",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Token throughput",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum by (direction) (rate(crystal_ball_llm_tokens_total[5m]))",
          "legendFormat": "{{direction}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "LLM latency p95",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, model) (rate(crystal_ball_llm_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Fallback count",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum by (reason) (increase(crystal_ball_llm_fallback_total[1h]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "LLM circuit state",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "max by (name) (crystal_ball_llm_circuit_state)",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Sensor anomalies (5m)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "expr": "sum by (direction) (increase(crystal_ball_sensor_anomalies_total[5m]))",
          "legendFormat": "{{direction}}"
        }
      ]
    }
  ],
  "annotations": {
    "list": []
  }
}